# Console Firebase → Configurações do projeto → Seus apps → SDK Web
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# URL do servidor Node em ./functions. No dev o Vite encaminha /api para a porta 8787.
VITE_FIREBASE_FUNCTIONS_URL=/api

# true só quando os emuladores locais estão rodando
VITE_FIREBASE_USE_EMULATOR=false

# Servidor em ./functions (não vai no build do Vite)
# FIREBASE_PROJECT_ID=autonegocie-257c3
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8088
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
